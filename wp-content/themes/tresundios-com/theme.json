{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "red",
					"name": "Tresundios red",
					"color": "#c74634"
				},
				{
					"slug": "red-deep",
					"name": "Red (small text on light)",
					"color": "#b23e2d"
				},
				{
					"slug": "red-bright",
					"name": "Red (small text on dark)",
					"color": "#e46a54"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#0a0a0a"
				},
				{
					"slug": "ink-2",
					"name": "Ink 2",
					"color": "#161616"
				},
				{
					"slug": "ink-3",
					"name": "Ink 3",
					"color": "#2a2a2a"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#fafafa"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "grey-1",
					"name": "Grey 1",
					"color": "#ececec"
				},
				{
					"slug": "grey-2",
					"name": "Grey 2",
					"color": "#d6d6d6"
				},
				{
					"slug": "grey-3",
					"name": "Grey 3 (dark backgrounds only)",
					"color": "#9a9a9a"
				},
				{
					"slug": "grey-4",
					"name": "Grey 4",
					"color": "#5c5c5c"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", \"Arial Narrow\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "700 800",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "500 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Label",
					"size": "12px",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "clamp(16px, 1.5vw, 18px)",
					"fluid": false
				},
				{
					"slug": "h4",
					"name": "H4",
					"size": "clamp(20px, 1.9vw, 24px)",
					"fluid": false
				},
				{
					"slug": "h3",
					"name": "H3",
					"size": "clamp(24px, 2.6vw, 34px)",
					"fluid": false
				},
				{
					"slug": "h2",
					"name": "H2",
					"size": "clamp(36px, 5.4vw, 76px)",
					"fluid": false
				},
				{
					"slug": "h1",
					"name": "H1",
					"size": "clamp(44px, 5.8vw, 88px)",
					"fluid": false
				},
				{
					"slug": "giant",
					"name": "Giant",
					"size": "clamp(80px, 15vw, 230px)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "16px"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "24px"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "48px"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(48px, 6vw, 80px)"
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "clamp(80px, 11vw, 140px)"
				}
			],
			"blockGap": null
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true
		},
		"custom": {
			"radius": "24px",
			"ease": "cubic-bezier(.22,1,.36,1)",
			"easeSnap": "cubic-bezier(.65,0,.35,1)",
			"gutter": "1rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--red)",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1",
					"letterSpacing": "-.035em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h4)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--red)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "15px",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "17px",
						"bottom": "17px",
						"left": "26px",
						"right": "26px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "cta-book-call",
			"title": "Book a call CTA",
			"area": "uncategorized"
		}
	],
	"customTemplates": []
}
